{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woodstoch.github.io/github-review-runtime/schemas/review-packet.schema.json",
  "title": "Review Packet Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "repository",
    "pr_number",
    "author",
    "base_sha",
    "head_sha",
    "diff_sha256",
    "files",
    "packet_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "diff_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the canonical UTF-8 JSON manifest with packet_sha256 excluded. Canonicalization recursively sorts object keys, uses separators (',', ':'), emits no insignificant whitespace, and emits non-ASCII characters directly as UTF-8 rather than JSON Unicode escape sequences (equivalent to Python json.dumps with sort_keys=True, separators=(',', ':'), ensure_ascii=False). The manifest transitively binds all packet payload files through their SHA-256 digests in files."
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diff.patch",
        "pr.json",
        "verification.json",
        "context.md"
      ],
      "properties": {
        "diff.patch": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pr.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verification.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context.md": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "description": "SHA-256 digest of each immutable Review Packet payload file."
    }
  }
}
