{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woodstoch.github.io/github-review-runtime/schemas/review-packet.schema.json",
  "title": "Review Packet Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "repository",
    "pr_number",
    "author",
    "base_sha",
    "head_sha",
    "diff_sha256",
    "packet_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "diff_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the normalized Review Packet payload, excluding this manifest field itself."
    }
  }
}
