{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woodstoch.github.io/github-review-runtime/schemas/review-result.schema.json",
  "title": "Independent Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewer",
    "snapshot",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_sha",
        "head_sha",
        "diff_sha256",
        "packet_sha256"
      ],
      "properties": {
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "diff_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "packet_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "category",
        "claim",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3,}$"
        },
        "severity": {
          "enum": [
            "BLOCKING",
            "NON_BLOCKING",
            "SUGGESTION"
          ]
        },
        "category": {
          "enum": [
            "spec",
            "correctness",
            "regression",
            "testing",
            "compatibility",
            "concurrency",
            "error_handling",
            "standards"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "validation_hint": {
          "type": "string",
          "minLength": 1
        },
        "contract_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
