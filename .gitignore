# macOS metadata
.DS_Store
._*
.Spotlight-V100/
.Trashes/

# Python
__pycache__/
/node_modules/
*.py[cod]
*.pyo
*.pyd
build/
dist/
*.egg-info/
.venv-build/

# Local runtime state
.mco/state.json
.mco/native-sessions.json
