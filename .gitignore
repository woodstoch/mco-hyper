# Temp artifacts
*.tmp

# Local review runs. Historical tracked reports remain tracked.
/reports/review/*/

# Generated CI and dry-run output. Release signoffs under reports/gate remain visible.
/reports/adapter-contract/*/
/reports/dry-run/*/
